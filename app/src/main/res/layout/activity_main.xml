<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Navy background circle -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="-120dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/blob_navy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Gold background circle -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginStart="-70dp"
        android:layout_marginBottom="-60dp"
        android:background="@drawable/blob_gold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Green background circle -->
    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginEnd="-50dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/blob_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Logo halo -->
    <View
        android:id="@+id/logoHalo"
        android:layout_width="118dp"
        android:layout_height="118dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/logo_halo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo"
        app:layout_constraintBottom_toBottomOf="@id/logoHalo"
        app:layout_constraintEnd_toEndOf="@id/logoHalo"
        app:layout_constraintStart_toStartOf="@id/logoHalo"
        app:layout_constraintTop_toTopOf="@id/logoHalo" />

    <!-- Title -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.04"
        android:text="COMMUNITY CONNECT"
        android:textColor="#0D2B52"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoHalo" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/textSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:letterSpacing="0.08"
        android:text="WELCOME BACK"
        android:textColor="#9AA5B1"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textTitle" />

    <!-- Four color dots -->
    <LinearLayout
        android:id="@+id/dotsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSubtitle">

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_navy" />

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_red" />

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_gold" />

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/dot_green" />
    </LinearLayout>

    <!-- Get Started button -->
    <Button
        android:id="@+id/superButton"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/button_gradient"
        android:elevation="6dp"
        android:letterSpacing="0.06"
        android:text="GET STARTED"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dotsRow" />

    <!-- Forgot password -->
    <TextView
        android:id="@+id/textForgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Forgot password?"
        android:textColor="#0D2B52"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/superButton" />

    <!-- Gradient accent line -->
    <View
        android:layout_width="44dp"
        android:layout_height="3dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/accent_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textForgot" />

</androidx.constraintlayout.widget.ConstraintLayout>
